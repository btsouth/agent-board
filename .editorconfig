# Two-space Lua, four-space Python, and a final newline everywhere: the client
# compiles whatever it is given, so consistency here is the only thing keeping a
# diff readable.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{toc,xml}]
indent_size = 2

[Makefile]
indent_style = tab
